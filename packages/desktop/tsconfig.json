{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist/types",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    // 実際に配るものは Vite が dist/web へ出す。
    // ここは型検査のためだけに走らせるので JS を二重に吐かせない。
    "emitDeclarationOnly": true,
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vite.config.ts"]
}
