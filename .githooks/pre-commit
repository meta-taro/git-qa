#!/bin/sh
# commit の前に品質ゲートを通す（C92）。
#
# 2026-09-27 まで、この仕組みが一度も入っていなかった。手元の verify を
# 出力を絞って見て（C59 で禁じた形）、落ちた試験のまま commit した。
# 人が気をつける方式は必ず漏れるので、commit そのものを止める。
#
# 落ちたら、出力を全部読むこと（C59）。
#
# 先に置き場所を見る（作業の記録を公開リポに入れない）。速いので先に走らせる。
bash .github/scripts/oss-placement-check.sh || exit 1
exec pnpm verify
