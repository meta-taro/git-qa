{
  "name": "git-qa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI と人が一緒に動作検証をするための QA ランナー",
  "license": "MIT",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "live": "pnpm --filter @git-qa/host exec vite-node src/cli.ts",
    "run:sheet": "pnpm --filter @git-qa/host exec vite-node src/run-cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --build --force",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.12",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "minimumReleaseAge": 1440
  }
}
